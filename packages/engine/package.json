{
  "name": "@diffra/engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Pixel comparison engine for visual regression, written in Rust and loaded through Node-API",
  "main": "./index.js",
  "types": "./index.d.ts",
  "author": "Diffra",
  "license": "MIT",
  "homepage": "https://github.com/Diffra/core/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diffra/core.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/Diffra/core/issues"
  },
  "keywords": [
    "pixel-diff",
    "rust",
    "napi",
    "image-comparison",
    "visual-regression"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "diffra-diff",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "napi build --platform --release --esm",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "cargo clean && rm -f index.js index.d.ts *.node"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
