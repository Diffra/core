{
  "name": "@diffra/engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Pixel comparison engine for visual regression: a TypeScript implementation, and an optional native Rust build that gives the same results several times faster",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Diffra",
  "license": "MIT",
  "homepage": "https://github.com/Diffra/core/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diffra/core.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/Diffra/core/issues"
  },
  "keywords": [
    "pixel-diff",
    "rust",
    "napi",
    "image-comparison",
    "visual-regression"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./clustering": {
      "types": "./dist/clustering.d.ts",
      "import": "./dist/clustering.js",
      "default": "./dist/clustering.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js",
      "default": "./dist/png.js"
    }
  },
  "files": [
    "dist",
    "src",
    "native"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "tsc -b --clean && rm -rf dist",
    "build:native": "pnpm run build && node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
