{
  "name": "@diffra/demo-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Showcase design system and real working Storybook 8 demo with Diffra",
  "scripts": {
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --ci",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --quiet",
    "test:visual": "diffra test",
    "test:visual:approve": "diffra approve",
    "test:visual:serve": "diffra serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diffra/core": "workspace:*",
    "@diffra/engine": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/builder-vite": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
