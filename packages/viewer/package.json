{
  "name": "@diffra/viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "Minimalist Scandinavian visual regression review interface and report viewer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Diffra",
  "license": "MIT",
  "homepage": "https://github.com/Diffra/core/tree/main/packages/viewer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diffra/core.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/Diffra/core/issues"
  },
  "keywords": [
    "diff-viewer",
    "visual-regression",
    "ui-report",
    "design-system",
    "storybook",
    "testing"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle": "./dist/viewer.bundle.js",
    "./style.css": "./dist/viewer.bundle.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
