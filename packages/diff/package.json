{
  "name": "@diffra/diff",
  "version": "0.1.0",
  "type": "module",
  "description": "Hardware-accelerated Rust SIMD pixel diff engine with Node-API bindings and pure TypeScript fallback",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Diffra",
  "license": "MIT",
  "homepage": "https://github.com/Diffra/core/tree/main/packages/diff#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diffra/core.git",
    "directory": "packages/diff"
  },
  "bugs": {
    "url": "https://github.com/Diffra/core/issues"
  },
  "keywords": [
    "pixel-diff",
    "simd",
    "rust",
    "napi",
    "image-comparison",
    "visual-regression"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./clustering": {
      "types": "./dist/clustering.d.ts",
      "import": "./dist/clustering.js",
      "default": "./dist/clustering.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js",
      "default": "./dist/png.js"
    }
  },
  "files": [
    "dist",
    "src",
    "native"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
