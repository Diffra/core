{
  "name": "@diffra/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Visual regression execution pipeline and driver engine for Storybook, web apps, and design systems",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Diffra",
  "license": "MIT",
  "homepage": "https://github.com/Diffra/core/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diffra/core.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Diffra/core/issues"
  },
  "keywords": [
    "visual-regression",
    "visual-testing",
    "storybook",
    "design-system",
    "playwright"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.js",
      "default": "./dist/drivers/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "default": "./dist/playwright/index.js"
    },
    "./matchers": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "default": "./dist/playwright/index.js"
    },
    "./report": {
      "types": "./dist/report/generator.d.ts",
      "import": "./dist/report/generator.js",
      "default": "./dist/report/generator.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "tsc -b --clean && rm -rf dist",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@diffra/engine": "workspace:*",
    "@diffra/viewer": "workspace:*",
    "cosmiconfig": "^10.0.1",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@azure/storage-blob": "^12.0.0",
    "@google-cloud/storage": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  }
}
